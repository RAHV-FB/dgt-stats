# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environments and local configuration
.venv/
venv/
.env
.env.*
!.env.example

# Notebooks and editors
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store

# Local data: raw source files are tracked; derived layers are generated
data/interim/**
!data/interim/.gitkeep
data/processed/**
!data/processed/.gitkeep

# Generated reports: placeholders plus the published tables and figures
reports/figures/**
!reports/figures/.gitkeep
!reports/figures/*.svg
!reports/figures/captions.json
reports/tables/**
!reports/tables/.gitkeep
!reports/tables/*.csv

# The site's figures and downloadable tables are copied from reports/ at build time
site/figures/
site/tables/

# Build and coverage outputs
build/
dist/
htmlcov/
.coverage
coverage.xml
